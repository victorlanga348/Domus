PORT=3333
NODE_ENV=development
CORS_ORIGIN=http://localhost:3002

# Conexão Local (Host):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domus_db?schema=public

# Conexão Inter-Container (Docker Compose):
DATABASE_URL=postgresql://postgres:postgres@postgres_db:5432/domus_db?schema=public

# Credenciais do container PostgreSQL (usadas pelo docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=domus_db

JWT_SECRET=your-super-secret-jwt-key-min-32-chars
HOUSEHOLD_CODE_SECRET=your-household-code-salt
GOOGLE_CLIENT_ID=248488236065-n5dela4vbnsh5kdfqke3n3ol4nedp7m2.apps.googleusercontent.com
