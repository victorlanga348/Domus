PORT=3333
NODE_ENV=development
CORS_ORIGIN=asaberturasquepodemacessar

# Conexão Local (Host):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domus_db?schema=public

# Conexão Inter-Container (Docker Compose):
DATABASE_URL=postgresql://postgres:postgres@postgres_db:5432/domus_db?schema=public

# Credenciais e porta do container PostgreSQL (usadas pelo docker-compose)
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=domus_db

JWT_SECRET=senhafortedejwt
HOUSEHOLD_CODE_SECRET=codigofortesecreto
GOOGLE_CLIENT_ID=configuracomogoogle
